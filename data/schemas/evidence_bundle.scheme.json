{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://handoff-guardian.invalid/schemas/evidence-bundle.schema.json",
  "title": "Evidence Agent bundle",
  "description": "Evidence collected for one handoff. Provider status is explicit and is never inferred from returned records.",
  "type": "object",
  "required": ["evidence", "source_statuses", "missing_mandatory", "conflicts", "mandatory_satisfied"],
  "properties": {
    "evidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidenceRecord"}
    },
    "source_statuses": {
      "type": "array",
      "items": {"$ref": "#/$defs/sourceStatus"}
    },
    "missing_mandatory": {"type": "array", "items": {"type": "string"}},
    "conflicts": {"type": "array", "items": {"type": "object"}},
    "mandatory_satisfied": {"type": ["boolean", "null"]}
  },
  "$defs": {
    "evidenceRecord": {
      "type": "object",
      "required": ["evidence_id", "source", "account_id", "field", "value", "updated_at", "excerpt"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "account_id": {"type": "string", "minLength": 1},
        "field": {"type": "string", "minLength": 1},
        "value": {"type": ["string", "null"]},
        "updated_at": {"type": ["string", "null"], "format": "date-time"},
        "excerpt": {"type": ["string", "null"]},
        "category": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "sourceStatus": {
      "type": "object",
      "required": ["source", "status"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "status": {"enum": ["available", "unavailable", "timeout", "error", "invalid"]},
        "detail": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
